{
  "manifest_version": 3,
  "name": "GoalGuard AI - Intent-Aware Assistant",
  "version": "1.0.0",
  "description": "Monitors active tab alignment against your current productivity goal with gentle drift nudges.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GoalGuard AI"
  }
}
